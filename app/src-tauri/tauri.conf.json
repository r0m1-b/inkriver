{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InkRiver",
  "version": "0.1.0",
  "identifier": "io.github.r0m1-b.inkriver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; frame-src 'self'"
    },
    "windows": [
      {
        "title": "InkRiver",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "News",
    "shortDescription": "InkRiver, lecteur unifié Medium et Substack"
  }
}
